{
  "manifest_version": 3,
  "name": "Alfred – Tâches depuis Gmail & Calendar",
  "version": "1.2.0",
  "description": "Boutons dans Gmail et Google Calendar pour créer une tâche Alfred en un clic, un bouton pour se rappeler de reprogrammer un rendez-vous, et un bouton pour signer une pièce jointe PDF et la transférer rapidement.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Alfred"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content/common.js", "vendor/pdf-lib.min.js", "content/gmail.js", "content/sign.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["content/common.js", "content/calendar.js"],
      "run_at": "document_idle"
    }
  ]
}
